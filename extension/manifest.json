{
  "manifest_version": 3,
  "name": "Lumina AI \u2014 Complete Voice Assistant & Question Solver",
  "version": "1.0.0",
  "description": "Full Live Interview Voice Copilot, Real-Time Loopback Transcription, and 99%+ Accuracy Question Solver.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Lumina AI (Voice HUD & Question Solver)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "app.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "app.html",
        "sidepanel.html",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle_overlay": {
      "suggested_key": {
        "default": "Alt+H"
      },
      "description": "100% Invisible Hide/Show Floating Assistant"
    },
    "open_sidepanel": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Open Lumina Full Side Panel"
    }
  }
}